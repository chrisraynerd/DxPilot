<Application x:Class="JtdxAutoResume.V3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- DX Pilot visual system: restrained radio-console colours, clear action
             hierarchy and reusable surfaces. Operating semantics remain unchanged. -->
        <SolidColorBrush x:Key="AppNavy" Color="#0F1D2B" />
        <SolidColorBrush x:Key="AppNavyRaised" Color="#172B3D" />
        <SolidColorBrush x:Key="AppCanvas" Color="#EEF3F7" />
        <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppSurfaceMuted" Color="#F7F9FC" />
        <SolidColorBrush x:Key="AppBorder" Color="#D7E0E8" />
        <SolidColorBrush x:Key="AppText" Color="#14212B" />
        <SolidColorBrush x:Key="AppTextMuted" Color="#5B6B7A" />
        <SolidColorBrush x:Key="AppBlue" Color="#2563EB" />
        <SolidColorBrush x:Key="AppBlueDark" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AppGreen" Color="#16A34A" />
        <SolidColorBrush x:Key="AppAmber" Color="#D97706" />
        <SolidColorBrush x:Key="AppRed" Color="#DC2626" />

        <SolidColorBrush x:Key="SemanticNeutralBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SemanticNeutralForeground" Color="#111827" />
        <SolidColorBrush x:Key="SemanticNewDxccBackground" Color="#E9D5FF" />
        <SolidColorBrush x:Key="SemanticNewDxccForeground" Color="#581C87" />
        <SolidColorBrush x:Key="SemanticUnconfirmedDxccBackground" Color="#F3E8FF" />
        <SolidColorBrush x:Key="SemanticUnconfirmedDxccForeground" Color="#6B21A8" />
        <SolidColorBrush x:Key="SemanticNewGridBackground" Color="#DBEAFE" />
        <SolidColorBrush x:Key="SemanticNewGridForeground" Color="#1E3A8A" />
        <SolidColorBrush x:Key="SemanticNewStateBackground" Color="#CCFBF1" />
        <SolidColorBrush x:Key="SemanticNewStateForeground" Color="#134E4A" />
        <SolidColorBrush x:Key="SemanticRareDxccBackground" Color="#FEF3C7" />
        <SolidColorBrush x:Key="SemanticRareDxccForeground" Color="#78350F" />
        <SolidColorBrush x:Key="SemanticBandModeBackground" Color="#FFEDD5" />
        <SolidColorBrush x:Key="SemanticBandModeForeground" Color="#7C2D12" />
        <SolidColorBrush x:Key="SemanticHeardBackground" Color="#FFF7ED" />
        <SolidColorBrush x:Key="SemanticHeardForeground" Color="#9A3412" />
        <SolidColorBrush x:Key="SemanticMutedBackground" Color="#E2E8F0" />
        <SolidColorBrush x:Key="SemanticMutedForeground" Color="#475569" />
        <SolidColorBrush x:Key="SemanticNotContactableBackground" Color="#475569" />
        <SolidColorBrush x:Key="SemanticSuppressedBackground" Color="#334155" />
        <SolidColorBrush x:Key="SemanticPermanentSuppressedBackground" Color="#111827" />
        <SolidColorBrush x:Key="SemanticDarkForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SemanticFailedBackground" Color="#FEE2E2" />
        <SolidColorBrush x:Key="SemanticFailedForeground" Color="#7F1D1D" />
        <SolidColorBrush x:Key="SemanticFailedBorder" Color="#DC2626" />
        <SolidColorBrush x:Key="SemanticCallingBorder" Color="#F59E0B" />
        <SolidColorBrush x:Key="SemanticInProgressBorder" Color="#16A34A" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource AppText}" />
            <Setter Property="BorderBrush" Value="#BAC7D3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#EAF1F8" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#8EA4B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#DCE7F1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AppBlue}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBlueDark}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AppGreen}" />
            <Setter Property="BorderBrush" Value="#15803D" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#991B1B" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,10,8" />
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{StaticResource AppSurface}" />
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="#23384A" />
            <Setter Property="BorderBrush" Value="#385267" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="WorkspaceTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppText}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ChoiceChipCheckBox" TargetType="CheckBox">
            <Setter Property="Background" Value="#F3F6F9" />
            <Setter Property="BorderBrush" Value="#C8D4DF" />
            <Setter Property="Foreground" Value="#304455" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipChrome" Property="BorderBrush" Value="#7893AA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipChrome" Property="Background" Value="#183B56" />
                                <Setter TargetName="ChipChrome" Property="BorderBrush" Value="#183B56" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppNavigationTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource AppCanvas}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="White" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1" Padding="14,7">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="Transparent" />
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource AppCanvas}" Padding="14"
                                    TextElement.Foreground="{StaticResource AppText}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppNavigationTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4B5D6D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="#4B5D6D">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#EAF1F8" />
                                <Setter TargetName="NavChrome" Property="TextElement.Foreground" Value="#18344C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource AppNavyRaised}" />
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="#28465E" />
                                <Setter TargetName="NavChrome" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceSubTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#526577" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="SubTabChrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SubTabChrome" Property="Background" Value="#EEF3F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SubTabChrome" Property="Background" Value="#DCE9F5" />
                                <Setter Property="Foreground" Value="#183B56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF3" />
            <Setter Property="VerticalGridLinesBrush" Value="#EFF3F6" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AlternatingRowBackground" Value="#FAFCFD" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EFF4F8" />
            <Setter Property="Foreground" Value="#304455" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D7E0E8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style x:Key="WorkedCallsignTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WasCallWorkedBefore}" Value="True">
                    <Setter Property="ToolTip" Value="{Binding WorkedCallToolTip}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WasCallWorkedInSelectedProfile}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WasCallWorkedUnderAnotherProfileOnly}" Value="True">
                    <Setter Property="Foreground" Value="#718096" />
                    <Setter Property="TextDecorations">
                        <Setter.Value>
                            <TextDecorationCollection>
                                <TextDecoration Location="Strikethrough">
                                    <TextDecoration.Pen>
                                        <Pen Brush="#8A98A8" Thickness="1" DashStyle="{x:Static DashStyles.Dash}" />
                                    </TextDecoration.Pen>
                                </TextDecoration>
                            </TextDecorationCollection>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkedOtherCallsignMarkerStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="↺" />
            <Setter Property="Foreground" Value="#718096" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WasCallWorkedUnderAnotherProfileOnly}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="{Binding WorkedCallToolTip}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="WorkedCallsignCallTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Call}" Style="{StaticResource WorkedCallsignTextStyle}" />
                <TextBlock Style="{StaticResource WorkedOtherCallsignMarkerStyle}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="WorkedCallsignContactableCallTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ContactableCall}" Style="{StaticResource WorkedCallsignTextStyle}" />
                <TextBlock Style="{StaticResource WorkedOtherCallsignMarkerStyle}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SemanticStationRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource SemanticNeutralBackground}" />
            <Setter Property="Foreground" Value="{StaticResource SemanticNeutralForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OpportunityClass}" Value="NewDxcc">
                    <Setter Property="Background" Value="{StaticResource SemanticNewDxccBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticNewDxccForeground}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpportunityClass}" Value="UnconfirmedDxcc">
                    <Setter Property="Background" Value="{StaticResource SemanticUnconfirmedDxccBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticUnconfirmedDxccForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpportunityClass}" Value="NewGrid">
                    <Setter Property="Background" Value="{StaticResource SemanticNewGridBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticNewGridForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpportunityClass}" Value="NewState">
                    <Setter Property="Background" Value="{StaticResource SemanticNewStateBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticNewStateForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpportunityClass}" Value="RareDxcc">
                    <Setter Property="Background" Value="{StaticResource SemanticRareDxccBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticRareDxccForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpportunityClass}" Value="BandMode">
                    <Setter Property="Background" Value="{StaticResource SemanticBandModeBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticBandModeForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpportunityClass}" Value="Heard">
                    <Setter Property="Background" Value="{StaticResource SemanticHeardBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticHeardForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionStateClass}" Value="Muted">
                    <Setter Property="Background" Value="{StaticResource SemanticMutedBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticMutedForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionStateClass}" Value="NotContactable">
                    <Setter Property="Background" Value="{StaticResource SemanticNotContactableBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticDarkForeground}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionStateClass}" Value="Suppressed">
                    <Setter Property="Background" Value="{StaticResource SemanticSuppressedBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticDarkForeground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionStateClass}" Value="PermanentlySuppressed">
                    <Setter Property="Background" Value="{StaticResource SemanticPermanentSuppressedBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticDarkForeground}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionStateClass}" Value="Failed">
                    <Setter Property="Background" Value="{StaticResource SemanticFailedBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource SemanticFailedForeground}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SemanticFailedBorder}" />
                    <Setter Property="BorderThickness" Value="4,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionStateClass}" Value="Calling">
                    <Setter Property="BorderBrush" Value="{StaticResource SemanticCallingBorder}" />
                    <Setter Property="BorderThickness" Value="4,0,0,0" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionStateClass}" Value="InProgress">
                    <Setter Property="BorderBrush" Value="{StaticResource SemanticInProgressBorder}" />
                    <Setter Property="BorderThickness" Value="4,0,0,0" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionStateClass}" Value="Worked">
                    <Setter Property="BorderBrush" Value="{StaticResource SemanticInProgressBorder}" />
                    <Setter Property="BorderThickness" Value="4,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SemanticLegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
    </Application.Resources>
</Application>
