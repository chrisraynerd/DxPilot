<UserControl x:Class="JtdxAutoResume.V3.Views.AchievementProfileSelector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ToolTip="{Binding AchievementProfileSummary}">
                    <StackPanel Width="230" Margin="0,0,12,0">
                        <TextBlock Text="ACHIEVEMENT PROFILE · ALL VIEWS" Foreground="#BBD1E3" FontSize="10" />
                        <Grid Margin="0,4,0,0">
                            <ComboBox ItemsSource="{Binding Wanted.AchievementProfiles}"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedAchievementProfileKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="8,5"
                                      ToolTip="Choose which station callsign's ADIF credit DX Pilot uses. Stop assistance before changing profile.">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanChangeAchievementProfile}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <Border Padding="8,5"
                                    Background="{StaticResource AppSurfaceMuted}"
                                    BorderBrush="{StaticResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    ToolTip="This achievement profile remains fixed until the current hunting or analysis operation is stopped.">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanChangeAchievementProfile}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedAchievementProfileDisplayLabel}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />
                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="7,2"
                                            Background="#E5EBF1"
                                            CornerRadius="8">
                                        <TextBlock Text="PROFILE LOCKED"
                                                   Foreground="{StaticResource AppTextMuted}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                    </StackPanel>
</UserControl>
