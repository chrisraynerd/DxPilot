<UserControl x:Class="JtdxAutoResume.V3.Views.DxAssistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Auto-select best target" IsChecked="{Binding DxAssist.AutoSelectBestCq}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LogbookStatus}" VerticalAlignment="Center" Foreground="#526577" ToolTip="{Binding AdifDiagnostics}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Test Grid Selection" Command="{Binding TestGuiSelectionCommand}" MinWidth="190" />
                </StackPanel>
                <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#D8E0E8" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CurrentTargetStatus.OperatingMode}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentTargetStatus.SelectedTargetDisplay}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding CurrentTargetStatus.PlainStatusMessage}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="3" Text="{Binding CurrentTargetStatus.TxGateStatus}" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="DxAssistContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SelectedTargetColumn" Width="450" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Best Selectable Target" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding DxAssist.BestTarget.Callsign, TargetNullValue=None}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding DxAssist.BestTarget.Decode.EntityName}" FontSize="16" Foreground="#263645" />
                        <TextBlock Text="{Binding DxAssist.BestTarget.Score, StringFormat=Score {0}}" FontSize="16" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DxAssist.TargetSourceText}" TextWrapping="Wrap" Foreground="#526577" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding DxAssist.TargetSourceRowText}" TextWrapping="Wrap" Foreground="#9A3412" FontWeight="SemiBold" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DxAssist.WantedReasonText}" TextWrapping="Wrap" Foreground="#263645" Margin="0,2,0,14" />
                        <TextBlock Text="{Binding DxAssist.BestCandidateText}" TextWrapping="Wrap" Foreground="#263645" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DxAssist.SelectedIntendedTargetText}" TextWrapping="Wrap" Foreground="#263645" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DxAssist.ActiveLockedTargetText}" TextWrapping="Wrap" Foreground="#263645" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DxAssist.ActualJtdxDxCallText}" TextWrapping="Wrap" Foreground="#263645" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding DxAssist.TargetStateWarningText}" TextWrapping="Wrap" Foreground="#9A3412" FontWeight="SemiBold" Margin="0,4,0,10" />

                        <Separator />
                        <TextBlock Text="QSO State" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,6" />
                        <TextBlock Text="{Binding DxAssist.LockedTargetText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DxAssist.CallingElapsed}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.QsoStageText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.CallAttemptsText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.ReportRepeatsText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.TxMismatchText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.LastProgressFromTarget}" TextWrapping="Wrap" Foreground="#526577" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding DxAssist.LastMyTx}" TextWrapping="Wrap" Foreground="#526577" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.LastStageChange}" TextWrapping="Wrap" Foreground="#526577" Margin="0,3,0,12" />

                        <Separator />
                        <TextBlock Text="Safety / Recovery" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,6" />
                        <TextBlock Text="{Binding DxAssist.TxVerificationText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DxAssist.RecoveryModeText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.LastCorrectiveAction}" TextWrapping="Wrap" Foreground="#526577" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.SelectionMethodText}" TextWrapping="Wrap" Foreground="#263645" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.GuiSelectionStatus}" TextWrapping="Wrap" Foreground="#526577" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.LastObservedTransmitState}" TextWrapping="Wrap" Foreground="#526577" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DxAssist.StuckReasonText}" TextWrapping="Wrap" Foreground="#9A3412" Margin="0,3,0,12" />

                        <Separator />
                        <TextBlock Text="Ranking Explanation" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,6" />
                        <ItemsControl ItemsSource="{Binding DxAssist.BestTarget.Reasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding DxAssist.MoveOnAt}" Foreground="#526577" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Separator />
                        <TextBlock Text="DX Assist Recent Actions" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,6" />
                        <ListBox ItemsSource="{Binding DxAssistRecentActions}" BorderThickness="0" MaxHeight="140" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="False"
                          Background="#D8E0E8"
                          Cursor="SizeWE"
                          DragDelta="SelectedTargetSplitter_DragDelta"
                          DragCompleted="SelectedTargetSplitter_DragCompleted" />

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="12,0,0,0">
                <TabControl>
                    <TabItem Header="Ranked Target Candidates">
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox Content="Contactable only" IsChecked="{Binding DxAssist.ShowOnlyTargetable}" />
                                <CheckBox Content="Wanted only" IsChecked="{Binding DxAssist.ShowWantedOnly}" />
                                <CheckBox Content="Worked/confirmed" IsChecked="{Binding DxAssist.ShowWorkedConfirmed}" />
                                <CheckBox Content="Suppressed" IsChecked="{Binding DxAssist.ShowSuppressed}" />
                            </StackPanel>

                            <TextBox DockPanel.Dock="Bottom"
                                     Text="{Binding DxAssist.SelectedCandidate.Details, Mode=OneWay, TargetNullValue=Select a candidate to see details.}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="150"
                                     MaxHeight="210"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,10,0,0" />

                            <DataGrid ItemsSource="{Binding DxAssist.CandidateRows}"
                                      SelectedItem="{Binding DxAssist.SelectedCandidate}"
                                      RowStyle="{StaticResource SemanticStationRowStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      CanUserSortColumns="True"
                                      PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="CALL NOW" Command="{Binding PlacementTarget.DataContext.CallNowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Suppress indefinitely" Command="{Binding PlacementTarget.DataContext.PermanentlySuppressCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Release suppression" Command="{Binding PlacementTarget.DataContext.ReleaseSuppressionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rank" Binding="{Binding RankText}" Width="48" />
                                    <DataGridTemplateColumn Header="Call" CellTemplate="{StaticResource WorkedCallsignCallTemplate}" SortMemberPath="Call" Width="88" />
                                    <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="135" />
                                    <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="62" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="52" />
                                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="54" />
                                    <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="46" />
                                    <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="70" />
                                    <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedReason}" Width="*" MinWidth="170" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding TargetStatus}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Raw Decode Diagnostics">
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Parser and enrichment diagnostics" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding DxAssist.RecentDecodes}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      CanUserSortColumns="True"
                                      PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="CALL NOW" Command="{Binding PlacementTarget.DataContext.CallNowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Suppress indefinitely" Command="{Binding PlacementTarget.DataContext.PermanentlySuppressCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Release suppression" Command="{Binding PlacementTarget.DataContext.ReleaseSuppressionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource SemanticStationRowStyle}">
                                        <Setter Property="ToolTip" Value="{Binding ParserInterpretation}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding DisplayTime}" Width="90" />
                                    <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="60" />
                                    <DataGridTextColumn Header="DT" Binding="{Binding Dt}" Width="70" />
                                    <DataGridTextColumn Header="Offset" Binding="{Binding AudioOffset}" Width="85" />
                                    <DataGridTextColumn Header="Raw Message" Binding="{Binding RawText}" Width="220" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding MessageTypeText}" Width="140" />
                                    <DataGridTextColumn Header="Addressed Call" Binding="{Binding AddressedCall}" Width="135" />
                                    <DataGridTextColumn Header="Addressed Entity" Binding="{Binding AddressedEntity}" Width="150" />
                                    <DataGridTextColumn Header="Addressed DXCC" Binding="{Binding AddressedDxccNumber}" Width="120" />
                                    <DataGridTextColumn Header="Heard / Tx Call" Binding="{Binding HeardCall}" Width="140" />
                                    <DataGridTextColumn Header="Contactable Entity" Binding="{Binding ContactableEntity}" Width="155" />
                                    <DataGridTextColumn Header="Contactable DXCC" Binding="{Binding ContactableDxccNumber}" Width="130" />
                                    <DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="100" />
                                    <DataGridTextColumn Header="Grid" Binding="{Binding ReportedGrid}" Width="90" />
                                    <DataGridTextColumn Header="Grid Source" Binding="{Binding GridSource}" Width="105" />
                                    <DataGridTextColumn Header="QRZ Grid" Binding="{Binding QrzGrid}" Width="90" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="70" />
                                    <DataGridTextColumn Header="State Source" Binding="{Binding StateSource}" Width="105" />
                                    <DataGridTextColumn Header="QRZ Status" Binding="{Binding CallsignLookupStatus}" Width="105" />
                                    <DataGridTextColumn Header="Grid Owner" Binding="{Binding GridOwnerCall}" Width="120" />
                                    <DataGridTextColumn Header="Entity" Binding="{Binding PrimaryDisplayEntity}" Width="150" />
                                    <DataGridTextColumn Header="Contactable Call" Binding="{Binding ContactableCall}" Width="145" />
                                    <DataGridTextColumn Header="Confidence" Binding="{Binding ParseConfidenceText}" Width="115" />
                                    <DataGridTextColumn Header="Parser Reason" Binding="{Binding ParserReason}" Width="190" />
                                    <DataGridTextColumn Header="Interpretation" Binding="{Binding ParserInterpretation}" Width="260" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
