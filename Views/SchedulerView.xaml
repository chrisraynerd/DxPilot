<UserControl x:Class="JtdxAutoResume.V3.Views.SchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JtdxAutoResume.V3.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
        <StackPanel>
            <Expander Header="Mapping and diagnostic tools" Margin="0,0,0,12" IsExpanded="False" FontWeight="SemiBold">
            <Border Style="{StaticResource PanelBorder}" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="JTDX control mapping" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,10" Foreground="#526577" TextWrapping="Wrap"
                               Text="Map the complete row of 12 buttons at the bottom of the JTDX receive window. DX Pilot divides the box into 160m, 80m, 60m, 40m, 30m, 20m, 17m, 15m, 12m, 10m, 6m and 2m button centres." />
                    <WrapPanel>
                        <Button Content="Map button strip" Command="{Binding MapBandButtonStripCommand}" />
                        <Button Content="Test selected band" Command="{Binding TestBandMovementCommand}" />
                        <Button Content="Map Tx timing button" Command="{Binding MapTxEvenSelectorCommand}" />
                        <Button Content="Map Tx1 reset button" Command="{Binding MapTx1SelectorCommand}" />
                        <Button Content="Save choices" Command="{Binding SaveSettingsCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding BandAnalysis.CalibrationStatus}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            </Expander>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="Band Analysis" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,10" Foreground="#526577" TextWrapping="Wrap"
                                   Text="The main analysis compares both sides of each enabled band: stations and targets received by JTDX, then exactly two controlled CQ probes matched against PSK Reporter. The combined result selects where assistance should continue." />
                        <WrapPanel>
                            <StackPanel Margin="0,0,22,0">
                                <TextBlock Text="Measurement time per band" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding BandAnalysis.PskProbeMinuteOptions}"
                                          SelectedItem="{Binding BandAnalysis.PskPropagationProbeMinutes, Mode=TwoWay}"
                                          Width="110" Margin="0,5,0,0" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding BandAnalysis.PskProbeTimingSummary}" Margin="0,9,0,0" TextWrapping="Wrap" />
                        <CheckBox Content="Return to the starting band when Band Analysis was started with assistance off"
                                  IsChecked="{Binding BandAnalysis.ReturnToStartingBand, Mode=TwoWay}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding BandAnalysis.PskProbeStatus}" Margin="0,5,0,0" Foreground="#526577" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Start Band Analysis" Command="{Binding StartPskPropagationSurveyCommand}"
                                Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8" FontWeight="SemiBold" />
                        <Button Content="Stop analysis" Command="{Binding StopBandSurveyCommand}" />
                        <TextBlock Text="Uses the enabled bands below" Foreground="#526577" HorizontalAlignment="Right" Margin="0,7,8,0" />
                        <TextBlock Text="{Binding BandAnalysis.PskProgress}" HorizontalAlignment="Right" Margin="0,8,8,0"
                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="420" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Automatic Conditions Search" FontSize="17" FontWeight="SemiBold" />
                    <CheckBox Content="Automatically analyse enabled bands when current conditions deteriorate"
                              IsChecked="{Binding BandAnalysis.ConditionsSearchEnabled, Mode=TwoWay}"
                              Margin="0,8,0,4" />
                    <TextBlock Foreground="#526577" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="DX Pilot continuously monitors the current band. It only interrupts when the radio is safe, observes the cooldown, and gives any New DXCC absolute priority." />
                    <CheckBox Content="Allow automatic analysis to transmit two CQ propagation probes on every enabled band"
                              IsChecked="{Binding BandAnalysis.ConditionsSearchUsePskProbes, Mode=TwoWay}"
                              FontWeight="SemiBold" Foreground="#9A3412"
                              ToolTip="When off, automatic analysis falls back to received signals only. Manual Band Analysis still offers the full transmitted test." />
                    <TextBlock Text="This permission is deliberately separate because automatic analysis may begin while assistance is running. A prominent warning remains visible before and throughout every analysis."
                               Foreground="#526577" TextWrapping="Wrap" Margin="24,-3,0,10" />
                    <Expander Header="Automatic analysis timing and trigger settings" IsExpanded="False" Margin="0,4,0,0">
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Minimum time between analyses" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchCooldownMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Minutes after one analysis finishes before another may start." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Minimum stay on the selected band" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchMinimumBandMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="How long to give the chosen band before ordinary triggers may move again." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Recent station listening window" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchMonitoringWindowMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="How far back DX Pilot counts unique stations on the current band." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Time without a useful target" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchNoUsefulTargetMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Trigger after this many minutes without a selectable CQ or wanted station." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Complete silence" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchSilentMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Trigger when JTDX has decoded no stations for this many minutes." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Band considered quiet below" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchLowStationThreshold, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Unique stations inside the recent listening window." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Quiet conditions must last" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchLowActivityPersistMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Minutes below the station threshold before it becomes a trigger." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Calling attempts without progress" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchPoorReplyAttempts, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Counted since the latest reply or QSO progress." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Calls must cover this many stations" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchPoorReplyDistinctStations, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Prevents one difficult station from causing a band analysis." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Improvement required before moving" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchSwitchImprovementPercent, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="The winning band must beat the current band by this percentage." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Optional scheduled UTC analyses" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBox Text="{Binding BandAnalysis.ConditionsSearchScheduleUtc, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="Comma-separated times, for example 06:00,18:00. Leave blank for none." Foreground="#526577" TextWrapping="Wrap" />
                        </StackPanel>
                    </UniformGrid>
                    </Expander>
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="Use one-minute listen-only fallback scans" IsChecked="{Binding BandAnalysis.ConditionsSearchUseQuickSurvey, Mode=TwoWay}" Margin="0,0,20,0"
                                  ToolTip="Used only when automatic PSK probes are disabled or their JTDX controls are unavailable." />
                        <CheckBox Content="Repeat an unclear listen-only fallback using the full listening time" IsChecked="{Binding BandAnalysis.ConditionsSearchFullSurveyWhenAmbiguous, Mode=TwoWay}" Margin="0,0,20,0" />
                        <CheckBox Content="Move automatically to the best band" IsChecked="{Binding BandAnalysis.ConditionsSearchMoveToBestBand, Mode=TwoWay}" Margin="0,0,20,0" />
                        <CheckBox Content="Survey after startup" IsChecked="{Binding BandAnalysis.ConditionsSearchSurveyOnStartup, Mode=TwoWay}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding BandAnalysis.AutomaticStatus}" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BandAnalysis.HistorySummary}" Margin="0,5,0,0" Foreground="#526577" TextWrapping="Wrap" />
                    <Button Content="Open Band Analysis log" Command="{Binding OpenBandAnalysisHistoryCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Expander Header="Listen-only diagnostic scan" Margin="0,0,0,12" IsExpanded="False" FontWeight="SemiBold">
            <Border Style="{StaticResource PanelBorder}" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,22,0">
                        <TextBlock Text="Listen on each band" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding BandAnalysis.DwellMinuteOptions}"
                                  SelectedItem="{Binding BandAnalysis.DwellMinutes, Mode=TwoWay}"
                                  Width="110" Margin="0,5,0,0" />
                        <TextBlock Text="minutes" Foreground="#526577" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,22,0">
                        <TextBlock Text="Survey cycles" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding BandAnalysis.SurveyCycleOptions}"
                                  SelectedItem="{Binding BandAnalysis.SurveyCycles, Mode=TwoWay}"
                                  Width="100" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,22,0" VerticalAlignment="Center">
                        <CheckBox Content="Return to starting band when complete"
                                  IsChecked="{Binding BandAnalysis.ReturnToStartingBand, Mode=TwoWay}" />
                        <TextBlock Text="Diagnostic only: this scan never transmits and cannot measure where your signal is being heard. Each timer begins after a complete FT8/FT4 sample."
                                   Foreground="#526577" TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Start listen-only scan" Command="{Binding StartBandSurveyCommand}" />
                            <Button Content="Stop" Command="{Binding StopBandSurveyCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding BandAnalysis.Progress}" HorizontalAlignment="Right" Margin="0,8,8,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
            </Expander>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding BandAnalysis.Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BandAnalysis.OverallSummary}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="15" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Bands and live results" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Tick only the bands DX Pilot may visit. Select any row before using Test selected band."
                               Foreground="#526577" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding BandAnalysis.Bands}"
                              SelectedItem="{Binding BandAnalysis.SelectedBand, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              MinHeight="325">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Search" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                            <DataGridTextColumn Header="Band" Binding="{Binding Band}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="Movement" Binding="{Binding MovementStatus}" IsReadOnly="True" Width="125" />
                            <DataGridTextColumn Header="Survey" Binding="{Binding SurveyStatus}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="Listened" Binding="{Binding ObservedDisplay}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Stations" Binding="{Binding UniqueStations}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="CQ" Binding="{Binding CqCallers}" IsReadOnly="True" Width="50" />
                            <DataGridTextColumn Header="New DXCC" Binding="{Binding NewDxccStations}" IsReadOnly="True" Width="75" />
                            <DataGridTextColumn Header="Main activity" Binding="{Binding MainArea}" IsReadOnly="True" Width="135" />
                            <DataGridTextColumn Header="DX &gt;2,500 mi" Binding="{Binding DistantStations}" IsReadOnly="True" Width="95" />
                            <DataGridTextColumn Header="Long DX" Binding="{Binding LongDxStations}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="DX reach" Binding="{Binding ReachDisplay}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Wanted" Binding="{Binding WantedStations}" IsReadOnly="True" Width="65" />
                            <DataGridTextColumn Header="Activity" Binding="{Binding ActivityScore}" IsReadOnly="True" Width="65" />
                            <DataGridTextColumn Header="DX score" Binding="{Binding DxReachScore}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="PSK heard by" Binding="{Binding PskReceiversDisplay}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="PSK reach" Binding="{Binding PskReachDisplay}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="PSK strongest" Binding="{Binding PskSnrDisplay}" IsReadOnly="True" Width="95" />
                            <DataGridTextColumn Header="PSK main area" Binding="{Binding PskMainArea}" IsReadOnly="True" Width="135" />
                            <DataGridTextColumn Header="PSK score" Binding="{Binding PskScoreDisplay}" IsReadOnly="True" Width="75" />
                            <DataGridTextColumn Header="Trend" Binding="{Binding Trend}" IsReadOnly="True" Width="115" />
                            <DataGridTextColumn Header="Choice score" Binding="{Binding ConditionsScore, StringFormat={}{0:0}}" IsReadOnly="True" Width="85" />
                            <DataGridTextColumn Header="Assessment" Binding="{Binding Assessment}" IsReadOnly="True" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Selected band detail" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BandAnalysis.SelectedBand.Detail}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BandAnalysis.SelectedBand.PskDetail}" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#315B75" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Text="PSK propagation map" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BandAnalysis.PskMap.Status}" Margin="0,4,0,8" Foreground="#526577" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding BandAnalysis.PskMap.Bands}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding Colour}" BorderThickness="2" CornerRadius="5" Margin="0,0,8,7" Padding="7,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding Colour}" Width="13" Height="13" CornerRadius="7" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <Button Content="Use band"
                                                Padding="7,2" MinWidth="62" Margin="0"
                                                Command="{Binding DataContext.MoveToPskSurveyBandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Band}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="#B7C7D3" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Height="410">
                        <views:PskReporterMapControl Model="{Binding BandAnalysis.PskMap}" />
                    </Border>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding BandAnalysis.PskMap.SelectedReport.Detail}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Move to selected report's band" Margin="12,0,0,0"
                                Command="{Binding MoveToPskSurveyBandCommand}"
                                CommandParameter="{Binding BandAnalysis.PskMap.SelectedReport.Band}" />
                    </Grid>
                    <TextBlock Text="Yellow triangle: your station · Receiver dots: colour by surveyed band · Map © OpenStreetMap contributors"
                               Foreground="#526577" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
