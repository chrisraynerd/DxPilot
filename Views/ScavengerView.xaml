<UserControl x:Class="JtdxAutoResume.V3.Views.ScavengerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="CompactHuntHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="3,6" /></Style>
  <DataTemplate x:Key="ScavengerOpportunityPanelTemplate">
   <Border Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,7,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
     <Grid>
      <DataGrid ColumnHeaderStyle="{StaticResource CompactHuntHeader}" ColumnHeaderHeight="32" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="28"
       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
       <DataGrid.ContextMenu><ContextMenu>
        <MenuItem Header="QRZ" Command="{Binding PlacementTarget.Tag.LookupQrzCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
         CommandParameter="{Binding PlacementTarget.SelectedItem.Decode, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
       </ContextMenu></DataGrid.ContextMenu>
       <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource SemanticStationRowStyle}">
        <Setter Property="ToolTip"><Setter.Value><TextBlock><Run Text="{Binding Reason, Mode=OneWay}" /><LineBreak /><Run Text="{Binding Status, Mode=OneWay}" /><LineBreak /><Run Text="{Binding Decode.RawText, Mode=OneWay}" /></TextBlock></Setter.Value></Setter>
       </Style></DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Call" Width="85" MinWidth="85"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <ContentControl Content="{Binding Decode}" ContentTemplate="{StaticResource WorkedCallsignContactableCallTemplate}" />
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Country" Binding="{Binding Decode.CountryDisplay}" Width="100" MinWidth="100" />
        <DataGridTextColumn Header="SNR" Binding="{Binding Decode.Snr}" Width="50" MinWidth="50" />
        <DataGridTextColumn Header="Wanted reason" Binding="{Binding Reason}" Width="*" MinWidth="100">
         <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style></DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" MinWidth="120" />
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="No current wanted stations in this category." Foreground="{StaticResource AppTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="15" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </DockPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="0,4,0,0">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="150" />
  </Grid.RowDefinitions>
  <Border Style="{StaticResource PanelBorder}" Padding="12,9" Margin="0,0,0,8">
   <StackPanel>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="Scavenger" FontSize="18" FontWeight="SemiBold" />
     <TextBlock Text="{Binding Scavenger.Phase}" FontWeight="SemiBold" Foreground="{StaticResource AppTextMuted}" Margin="14,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="{Binding Scavenger.Status}" TextWrapping="Wrap" Margin="0,5,0,4" />
    <TextBlock Text="{Binding Scavenger.RestingTargets}" TextWrapping="Wrap" Foreground="{StaticResource AppTextMuted}">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
      <DataTrigger Binding="{Binding Scavenger.RestingTargets}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <TextBlock Text="{Binding Scavenger.FilterSummary}" Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
    <Expander Header="Hunt preferences" Margin="0,8,0,0">
     <ScrollViewer MaxHeight="205" VerticalScrollBarVisibility="Auto">
      <StackPanel IsEnabled="{Binding CanConfigureScavenger}" Margin="0,8,0,0">
       <WrapPanel Margin="0,0,0,8">
        <TextBlock Text="Hunt:" FontWeight="SemiBold" Margin="0,0,12,0" />
        <CheckBox Content="New / unconfirmed DXCC" IsChecked="{Binding Scavenger.WantedDxcc}" Margin="0,0,20,0" />
        <CheckBox Content="Wanted grids" IsChecked="{Binding Scavenger.WantedGrids}" Margin="0,0,20,0" />
        <CheckBox Content="Wanted USA states" IsChecked="{Binding Scavenger.WantedStates}" />
       </WrapPanel>
       <WrapPanel Margin="0,0,0,8">
        <TextBlock Text="Overall always; also include:" Margin="0,0,12,0" />
        <CheckBox Content="Current band" IsChecked="{Binding Scavenger.IncludeBand}" Margin="0,0,20,0" />
        <CheckBox Content="Current mode" IsChecked="{Binding Scavenger.IncludeMode}" Margin="0,0,20,0" />
        <CheckBox Content="Band + mode" IsChecked="{Binding Scavenger.IncludeBandMode}" />
       </WrapPanel>
       <TextBlock Text="Never-worked DXCC always takes priority. Confirmation follows your global settings (LoTW by default). These filters do not change Wanted Sniper."
        Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
       <WrapPanel>
        <TextBlock Text="Listen (minutes)" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Scavenger.MinuteChoices}" SelectedItem="{Binding Scavenger.ListenMinutes}" Width="60" Margin="0,0,18,0" />
        <TextBlock Text="Silent: skip rounds" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Scavenger.RoundChoices}" SelectedItem="{Binding Scavenger.DeadSkipRounds}" Width="60" Margin="0,0,18,0" />
        <TextBlock Text="Few nearby stations: skip rounds" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Scavenger.RoundChoices}" SelectedItem="{Binding Scavenger.QuietSkipRounds}" Width="60" />
       </WrapPanel>
       <WrapPanel Margin="0,8,0,0">
        <TextBlock Text="Maximum unanswered calling (minutes)" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Scavenger.CallingMinuteChoices}" SelectedItem="{Binding Scavenger.MaxCallingMinutes}" Width="65" Margin="0,0,18,0" />
        <TextBlock Text="Then rest that callsign (search rounds)" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding Scavenger.TargetRestRoundChoices}" SelectedItem="{Binding Scavenger.TargetRestRounds}" Width="65" />
       </WrapPanel>
       <TextBlock Text="Overall DXCC: call until stale or the unanswered time limit. At the limit, allow a final reply then rest that callsign across all bands. A QSO with replies to you remains protected. If stale first, listen for five extra minutes. Other needs retain normal attempt limits. No PSK or Band Analysis."
        Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
       <TextBlock Text="Nearby = up to five stations, all at known distances within 1,500 miles. One distant station keeps the band in rotation. If every band is resting, the earliest-due band gets a real visit."
        Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
     </ScrollViewer>
    </Expander>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="10,8" Margin="0,0,0,8">
   <StackPanel>
    <DockPanel Margin="2,0,2,5">
     <TextBlock DockPanel.Dock="Right" Text="{Binding Scavenger.Round, StringFormat=Round {0}}" FontWeight="SemiBold" />
     <TextBlock Text="BAND ROTATION · enabled bands" Style="{StaticResource SectionEyebrow}" />
    </DockPanel>
    <Expander Header="Choose bands" Margin="2,0,0,6">
     <ItemsControl ItemsSource="{Binding Scavenger.Bands}" Margin="0,8,0,2">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <CheckBox Content="{Binding Band}" IsChecked="{Binding BandChoice.Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        IsEnabled="{Binding DataContext.CanConfigureScavenger, RelativeSource={RelativeSource AncestorType=UserControl}}"
        Margin="0,0,18,6" />
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Expander>
    <ItemsControl ItemsSource="{Binding Scavenger.Bands}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Margin="0,0,6,0" Padding="8,4" Width="146" BorderThickness="1" CornerRadius="5">
        <Border.Style>
         <Style TargetType="Border">
          <Setter Property="Background" Value="#F7F9FC" /><Setter Property="BorderBrush" Value="#D7E0E8" />
          <Style.Triggers>
           <DataTrigger Binding="{Binding BandChoice.Enabled}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
           <DataTrigger Binding="{Binding Revisit}" Value="Current band"><Setter Property="Background" Value="#E4F1FF" /><Setter Property="BorderBrush" Value="#2563EB" /></DataTrigger>
          </Style.Triggers>
         </Style>
        </Border.Style>
        <Border.ToolTip><StackPanel><TextBlock Text="{Binding Status}" FontWeight="Bold" /><TextBlock Text="{Binding Activity}" /><TextBlock Text="{Binding Revisit}" /></StackPanel></Border.ToolTip>
        <StackPanel>
         <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding HeardCount}" FontSize="11" Foreground="{StaticResource AppTextMuted}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Band}" FontWeight="SemiBold" FontSize="13" />
         </DockPanel>
         <TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
         <TextBlock Text="{Binding Revisit}" FontSize="11" Foreground="{StaticResource AppTextMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>
  <DockPanel Grid.Row="2">
   <DockPanel DockPanel.Dock="Top" Margin="2,0,8,6">
    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentBand, StringFormat=Current band: {0}}" />
    <TextBlock Text="WANTED OPPORTUNITIES · highlighted rows are the current target; eligible does not mean already calling" Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" />
   </DockPanel>
   <ItemsControl ItemsSource="{Binding Scavenger.OpportunityPanels}" ItemTemplate="{StaticResource ScavengerOpportunityPanelTemplate}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   </ItemsControl>
  </DockPanel>
 </Grid>
</UserControl>
