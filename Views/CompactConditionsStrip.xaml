<UserControl x:Class="JtdxAutoResume.V3.Views.CompactConditionsStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
    <Border Background="#F8FAFC"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="5"
            Padding="10,7"
            Margin="0,12,0,0">
        <ItemsControl ItemsSource="{Binding BandAnalysis.ConditionsIndicators}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,10,0" ToolTip="{Binding Detail}">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding RemainingPercent, Mode=OneWay}"
                                     Height="7"
                                     Margin="0,4,0,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#16A34A" />
                                    <Setter Property="Background" Value="#DCFCE7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Near">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                            <Setter Property="Background" Value="#FEF3C7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Ready">
                                            <Setter Property="Foreground" Value="#DC2626" />
                                            <Setter Property="Background" Value="#FEE2E2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Inactive">
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                            <Setter Property="Background" Value="#E2E8F0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
