<UserControl x:Class="JtdxAutoResume.V3.Views.SessionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="14,11" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock Text="{Binding SessionHistory.ViewHeading}" FontWeight="SemiBold" FontSize="17" />
                    <TextBlock Text="{Binding SessionHistory.ViewSubtitle}"
                               Foreground="{StaticResource AppTextMuted}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="Search" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBox Text="{Binding SessionHistory.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="360" Margin="0" HorizontalAlignment="Left"
                                 ToolTip="Search callsign, country, DXCC number, grid, state, wanted reason or outcome." />
                    </DockPanel>
                    <TextBlock Text="{Binding SessionHistory.Status}" Foreground="{StaticResource AppTextMuted}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="{Binding SessionHistory.ArchiveButtonText}" Command="{Binding SessionHistory.ToggleArchiveCommand}" />
                    <Button Content="Export CSV" Command="{Binding SessionHistory.ExportCommand}" />
                    <Button Content="Clear session" Command="{Binding SessionHistory.ClearCommand}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Expander Grid.Row="1" Header="Filters and colour key" IsExpanded="False" Margin="0,0,0,8">
            <Border Style="{StaticResource PanelBorder}" Padding="14,10" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Station category" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,4,0,0">
                        <CheckBox Content="New / unconfirmed DXCC"
                                  IsChecked="{Binding SessionHistory.ShowDxcc}"
                                  ToolTip="Countries that have never been worked, or have been worked but are not yet confirmed under your selected DXCC confirmation rule." />
                        <CheckBox Content="Grids" IsChecked="{Binding SessionHistory.ShowGrids}" />
                        <CheckBox Content="USA States" IsChecked="{Binding SessionHistory.ShowUsaStates}" />
                        <CheckBox Content="Rare country (DXCC already confirmed)"
                                  IsChecked="{Binding SessionHistory.ShowRareConfirmed}"
                                  ToolTip="An optional repeat contact with a country you have already confirmed, because it ranks highly in the rarity list. It does not outrank a needed DXCC." />
                        <CheckBox Content="Other heard" IsChecked="{Binding SessionHistory.ShowHeard}"
                                  ToolTip="Ordinary stations heard during the session, including stations that were not wanted." />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,3">
                        <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticNewDxccBackground}" /><TextBlock Text="New DXCC" Margin="0,0,10,0" />
                        <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticUnconfirmedDxccBackground}" /><TextBlock Text="Unconfirmed DXCC" Margin="0,0,10,0" />
                        <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticNewGridBackground}" /><TextBlock Text="Wanted grid" Margin="0,0,10,0" />
                        <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticNewStateBackground}" /><TextBlock Text="Wanted state" Margin="0,0,10,0" />
                        <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticRareDxccBackground}" /><TextBlock Text="Rare DXCC" Margin="0,0,10,0" />
                        <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticHeardBackground}" /><TextBlock Text="Other heard" />
                    </WrapPanel>
                    <TextBlock Text="Outcome" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <WrapPanel>
                        <CheckBox Content="Seen only" IsChecked="{Binding SessionHistory.ShowSeenOnly}" />
                        <CheckBox Content="Called" IsChecked="{Binding SessionHistory.ShowCalledOnly}" />
                        <CheckBox Content="Worked/logged" IsChecked="{Binding SessionHistory.ShowWorked}" />
                        <CheckBox Content="Missed" IsChecked="{Binding SessionHistory.ShowMissed}" />
                        <CheckBox Content="Suppressed" IsChecked="{Binding SessionHistory.ShowSuppressed}" />
                        <CheckBox Content="Failed / mismatch" IsChecked="{Binding SessionHistory.ShowFailedMismatch}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Expander>

        <DataGrid Grid.Row="2"
                  MinHeight="300"
                  ItemsSource="{Binding SessionHistory.Opportunities}"
                  SelectedItem="{Binding SessionHistory.SelectedOpportunity}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource SemanticStationRowStyle}">
                    <!-- Live tables use a four-pixel action stripe. In Session History it
                         renders as disconnected dots, so retain category fills without it. -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OpportunityClass}" Value="NewDxcc">
                            <Setter Property="Background" Value="{StaticResource SemanticNewDxccBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticNewDxccForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpportunityClass}" Value="UnconfirmedDxcc">
                            <Setter Property="Background" Value="{StaticResource SemanticUnconfirmedDxccBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticUnconfirmedDxccForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpportunityClass}" Value="NewGrid">
                            <Setter Property="Background" Value="{StaticResource SemanticNewGridBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticNewGridForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpportunityClass}" Value="NewState">
                            <Setter Property="Background" Value="{StaticResource SemanticNewStateBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticNewStateForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpportunityClass}" Value="RareDxcc">
                            <Setter Property="Background" Value="{StaticResource SemanticRareDxccBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticRareDxccForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpportunityClass}" Value="BandMode">
                            <Setter Property="Background" Value="{StaticResource SemanticBandModeBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticBandModeForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OpportunityClass}" Value="Heard">
                            <Setter Property="Background" Value="{StaticResource SemanticHeardBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticHeardForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionStateClass}" Value="Failed">
                            <Setter Property="BorderThickness" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionStateClass}" Value="Calling">
                            <Setter Property="BorderThickness" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionStateClass}" Value="InProgress">
                            <Setter Property="BorderThickness" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionStateClass}" Value="Worked">
                            <Setter Property="BorderThickness" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionStateClass}" Value="Suppressed">
                            <Setter Property="Background" Value="{StaticResource SemanticSuppressedBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticDarkForeground}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActionStateClass}" Value="PermanentlySuppressed">
                            <Setter Property="Background" Value="{StaticResource SemanticPermanentSuppressedBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SemanticDarkForeground}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="CALL NOW" Command="{Binding PlacementTarget.DataContext.CallNowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Suppress indefinitely" Command="{Binding PlacementTarget.DataContext.PermanentlySuppressCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Release suppression" Command="{Binding PlacementTarget.DataContext.ReleaseSuppressionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Session" Binding="{Binding SessionDateText}" Width="76" />
                <DataGridTextColumn Header="Rank" Binding="{Binding RankText}" Width="48" />
                <DataGridTemplateColumn Header="Call" CellTemplate="{StaticResource WorkedCallsignCallTemplate}" SortMemberPath="Call" Width="88" />
                <DataGridTextColumn Header="Country" Binding="{Binding Entity}" Width="135" />
                <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="62" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="52" />
                <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="52" />
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="52" />
                <DataGridTextColumn Header="First" Binding="{Binding FirstSeenText, Mode=OneWay}" Width="64" />
                <DataGridTextColumn Header="Last" Binding="{Binding LastSeenText, Mode=OneWay}" Width="64" />
                <DataGridTextColumn Header="Seen For" Binding="{Binding SeenForText, Mode=OneWay}" Width="70" />
                <DataGridTextColumn Header="Last Heard" Binding="{Binding AgeText, Mode=OneWay}" Width="72" />
                <DataGridTextColumn Header="Times Seen" Binding="{Binding SeenCount}" Width="72" />
                <DataGridTextColumn Header="Call Tries" Binding="{Binding AttemptCount}" Width="66" />
                <DataGridTextColumn Header="Best SNR" Binding="{Binding BestSnrText}" Width="64" />
                <DataGridTextColumn Header="Last SNR" Binding="{Binding LastSnr}" Width="64" />
                <DataGridTextColumn Header="Selected" Binding="{Binding SelectionText}" Width="68" />
                <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="70" />
                <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedReasonDisplay}" Width="*" MinWidth="170" />
                <DataGridTextColumn Header="Status" Binding="{Binding StationStatusDisplay}" Width="125" />
            </DataGrid.Columns>
        </DataGrid>

        <Expander Grid.Row="3" Header="Selected station details" IsExpanded="False" Margin="0,8,0,0">
            <TextBox Text="{Binding SessionHistory.SelectedOpportunity.Details, Mode=OneWay, TargetNullValue=Select a DX opportunity to see details.}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="150"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,6,0,0" />
        </Expander>

        <Expander Grid.Row="4" Header="Session history recent actions" IsExpanded="False" Margin="0,6,0,0">
            <Border Style="{StaticResource PanelBorder}" Padding="10" Margin="0,6,0,0" Height="100">
                <ListBox ItemsSource="{Binding SessionHistoryRecentActions}" BorderThickness="0" />
            </Border>
        </Expander>
    </Grid>
</UserControl>
