<UserControl x:Class="JtdxAutoResume.V3.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hunter Mode" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentTargetStatus.OperatingMode}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentTargetStatus.TargetSource}" Foreground="#526577" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Current Target" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentTargetStatus.SelectedTargetDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentTargetStatus.WantedReason}" Foreground="#526577" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="QSO / Control State" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentTargetStatus.AttemptCounterLabel}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentTargetStatus.PlainStatusMessage}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentTargetStatus.JtdxMatchStatus, StringFormat=JTDX: {0}}" Foreground="#526577" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="12,0,0,0">
                        <TextBlock Text="TX Gate" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentTargetStatus.TxGateStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentTargetStatus.SelectionMethod, StringFormat=Selection: {0}}" Foreground="#526577" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

        <UniformGrid Columns="6">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="UDP" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Dashboard.UdpStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="DX Pilot" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Dashboard.AutoResumeStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Pixel State" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Dashboard.PixelState}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Best Target" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Dashboard.BestTarget}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Dashboard.BestReason}" TextWrapping="Wrap" Foreground="#526577" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Text="Resumes" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Dashboard.ResumeCount}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Hunt State" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Dashboard.HuntState}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Recent Actions" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Export" Command="{Binding ExportRecentActionsCommand}" MinWidth="72" Padding="8,4" Margin="12,0,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding RecentActions}" BorderThickness="0" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Live Decode Feed" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding DxAssist.RecentDecodes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="520" PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="CALL NOW" Command="{Binding PlacementTarget.DataContext.CallNowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Suppress indefinitely" Command="{Binding PlacementTarget.DataContext.PermanentlySuppressCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Release suppression" Command="{Binding PlacementTarget.DataContext.ReleaseSuppressionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource SemanticStationRowStyle}">
                            <Setter Property="ToolTip" Value="{Binding ParserInterpretation}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rank" Binding="{Binding RankText}" Width="48" />
                        <DataGridTemplateColumn Header="Call" CellTemplate="{StaticResource WorkedCallsignContactableCallTemplate}" SortMemberPath="ContactableCall" Width="88" />
                        <DataGridTextColumn Header="Country" Binding="{Binding CountryDisplay}" Width="135" />
                        <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="62" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="52" />
                        <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="54" />
                        <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="46" />
                        <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="70" />
                        <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedReasonDisplay}" Width="170" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StationStatusDisplay}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
