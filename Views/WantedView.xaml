<UserControl x:Class="JtdxAutoResume.V3.Views.WantedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Wanted.Status}" Foreground="#526577" Margin="0,8,0,0" />
                <Border DockPanel.Dock="Bottom" BorderBrush="#D8E0E8" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current Sniper Target" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTargetStatus.SelectedTargetDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Wanted Reason" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTargetStatus.WantedReason}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTargetStatus.AttemptCounterLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentTargetStatus.PlainStatusMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TX / Selection" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTargetStatus.TxGateStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentTargetStatus.SelectionMethod}" Foreground="#526577" />
                        </StackPanel>
                    </Grid>
                </Border>
                <WrapPanel>
                    <TextBlock Text="Wanted scopes: Overall always" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="Include current band"
                              IsChecked="{Binding IncludeBandWanted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              ToolTip="Also treat an entity, grid or state as wanted when it has not been worked on the current band." />
                    <CheckBox Content="Include current mode"
                              IsChecked="{Binding IncludeModeWanted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              ToolTip="Also treat an entity, grid or state as wanted when it has not been worked using the current digital mode." />
                    <CheckBox Content="Include band + mode"
                              IsChecked="{Binding IncludeBandModeWanted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,18,0"
                              VerticalAlignment="Center"
                              ToolTip="Also hunt combinations such as an entity never worked on 20m FT4, even if the band and mode have each been worked separately." />

                    <TextBlock Text="Sniper targets:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Content="DXCC" IsChecked="{Binding SniperTargetsDxcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center"
                              ToolTip="Controls whether Wanted Sniper selects DXCC rows. The Wanted DXCC table always updates." />
                    <CheckBox Content="Grids" IsChecked="{Binding SniperTargetsGrids, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center"
                              ToolTip="Controls whether Wanted Sniper selects grid rows. The Wanted Grids table always updates." />
                    <CheckBox Content="USA States" IsChecked="{Binding SniperTargetsStates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center"
                              ToolTip="Controls whether Wanted Sniper selects state rows. The Wanted USA States table always updates." />
                    <CheckBox Content="New/unconfirmed DXCC: keep calling until stale (all modes)"
                              IsChecked="{Binding KeepCallingNewDxccUntilStale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              FontWeight="SemiBold"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="When enabled, an active never-worked or worked-but-unconfirmed DXCC ignores normal call-attempt and no-progress limits and remains locked until it replies, is logged, or goes stale. Wrong-target and QSO-stage safety limits still apply." />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Wanted DXCC" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Wanted.WantedDxcc}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource SemanticStationRowStyle}" MouseDoubleClick="WantedGrid_MouseDoubleClick" PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="CALL NOW" Command="{Binding PlacementTarget.DataContext.CallNowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Watch only" Command="{Binding DataContext.Wanted.WatchOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Suppress indefinitely" Command="{Binding PlacementTarget.DataContext.PermanentlySuppressCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Release suppression" Command="{Binding PlacementTarget.DataContext.ReleaseSuppressionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Copy callsign" Command="{Binding DataContext.Wanted.CopyCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy raw message" Command="{Binding DataContext.Wanted.CopyRawMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rank" Binding="{Binding RankText}" Width="45" />
                            <DataGridTemplateColumn Header="Call" CellTemplate="{StaticResource WorkedCallsignContactableCallTemplate}" SortMemberPath="ContactableCall" Width="82" />
                            <DataGridTextColumn Header="Country" Binding="{Binding Entity}" Width="112" />
                            <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="55" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="48" />
                            <DataGridTextColumn Header="Age" Binding="{Binding AgeText, Mode=OneWay}" Width="52" />
                            <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="44" />
                            <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="68" />
                            <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedReasonDisplay}" Width="175" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StationStatusDisplay}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="8,0,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Wanted Grids" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Wanted.WantedGrids}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource SemanticStationRowStyle}" MouseDoubleClick="WantedGrid_MouseDoubleClick" PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="CALL NOW" Command="{Binding PlacementTarget.DataContext.CallNowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Watch only" Command="{Binding DataContext.Wanted.WatchOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Suppress indefinitely" Command="{Binding PlacementTarget.DataContext.PermanentlySuppressCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Release suppression" Command="{Binding PlacementTarget.DataContext.ReleaseSuppressionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Copy callsign" Command="{Binding DataContext.Wanted.CopyCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy raw message" Command="{Binding DataContext.Wanted.CopyRawMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rank" Binding="{Binding RankText}" Width="45" />
                            <DataGridTemplateColumn Header="Call" CellTemplate="{StaticResource WorkedCallsignContactableCallTemplate}" SortMemberPath="ContactableCall" Width="82" />
                            <DataGridTextColumn Header="Country" Binding="{Binding Entity}" Width="112" />
                            <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="55" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="48" />
                            <DataGridTextColumn Header="Age" Binding="{Binding AgeText, Mode=OneWay}" Width="52" />
                            <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="44" />
                            <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="68" />
                            <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedReasonDisplay}" Width="175" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StationStatusDisplay}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Wanted USA States" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border DockPanel.Dock="Bottom" BorderBrush="#D8E0E8" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0" MaxHeight="115">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Wanted Recent Actions" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding WantedRecentActions}" BorderThickness="0" />
                    </DockPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Wanted.WantedStates}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource SemanticStationRowStyle}" MouseDoubleClick="WantedGrid_MouseDoubleClick" PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="CALL NOW" Command="{Binding PlacementTarget.DataContext.CallNowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Watch only" Command="{Binding DataContext.Wanted.WatchOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Suppress indefinitely" Command="{Binding PlacementTarget.DataContext.PermanentlySuppressCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Release suppression" Command="{Binding PlacementTarget.DataContext.ReleaseSuppressionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="Copy callsign" Command="{Binding DataContext.Wanted.CopyCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Copy raw message" Command="{Binding DataContext.Wanted.CopyRawMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rank" Binding="{Binding RankText}" Width="45" />
                        <DataGridTemplateColumn Header="Call" CellTemplate="{StaticResource WorkedCallsignContactableCallTemplate}" SortMemberPath="ContactableCall" Width="82" />
                        <DataGridTextColumn Header="Country" Binding="{Binding Entity}" Width="112" />
                        <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="55" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="48" />
                        <DataGridTextColumn Header="Age" Binding="{Binding AgeText, Mode=OneWay}" Width="52" />
                        <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="44" />
                        <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="68" />
                        <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedReasonDisplay}" Width="175" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StationStatusDisplay}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
