<UserControl x:Class="JtdxAutoResume.V3.Views.WantedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Wanted.Status}" Foreground="#526577" Margin="0,8,0,0" />
                <Border DockPanel.Dock="Bottom" BorderBrush="#D8E0E8" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current Sniper Target" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTargetStatus.SelectedTargetDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Wanted Reason" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTargetStatus.WantedReason}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTargetStatus.AttemptCounterLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentTargetStatus.PlainStatusMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TX / Selection" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentTargetStatus.TxGateStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CurrentTargetStatus.SelectionMethod}" Foreground="#526577" />
                        </StackPanel>
                    </Grid>
                </Border>
                <WrapPanel>
                    <TextBlock Text="Wanted Sniper" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="95" SelectedValue="{Binding Settings.Settings.WantedSniperMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,0,18,0">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Watch" />
                        <ComboBoxItem Content="Armed" />
                    </ComboBox>

                    <TextBlock Text="Scope" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="155" SelectedValue="{Binding Settings.Settings.WantedScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,0,18,0">
                        <ComboBoxItem Content="Overall" />
                        <ComboBoxItem Content="CurrentBand" />
                        <ComboBoxItem Content="CurrentMode" />
                        <ComboBoxItem Content="CurrentBandMode" />
                    </ComboBox>

                    <CheckBox Content="DXCC" IsChecked="{Binding Settings.Settings.EnableWantedDxcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox Content="Grids" IsChecked="{Binding Settings.Settings.EnableWantedGrids, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox Content="USA States" IsChecked="{Binding Settings.Settings.EnableWantedStates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Wanted DXCC" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Wanted.WantedDxcc}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="WantedGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Call this station" Command="{Binding DataContext.Wanted.CallWantedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Watch only" Command="{Binding DataContext.Wanted.WatchOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Suppress for 5 minutes" Command="{Binding DataContext.Wanted.SuppressWantedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Copy callsign" Command="{Binding DataContext.Wanted.CopyCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy raw message" Command="{Binding DataContext.Wanted.CopyRawMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="70" />
                            <DataGridTextColumn Header="Call" Binding="{Binding ContactableCall}" Width="90" />
                            <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="130" />
                            <DataGridTextColumn Header="Need" Binding="{Binding NeedStatusText}" Width="95" />
                            <DataGridTextColumn Header="Scope" Binding="{Binding WantedScopeText}" Width="115" />
                            <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="55" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="60" />
                            <DataGridTextColumn Header="Actionable" Binding="{Binding ActionabilityText}" Width="145" />
                            <DataGridTextColumn Header="Method" Binding="{Binding SelectionMethod}" Width="100" />
                            <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedDetail}" Width="*" />
                            <DataGridTextColumn Header="Age" Binding="{Binding AgeText, Mode=OneWay}" Width="55" />
                            <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="8,0,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Wanted Grids" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Wanted.WantedGrids}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="WantedGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Call this station" Command="{Binding DataContext.Wanted.CallWantedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Watch only" Command="{Binding DataContext.Wanted.WatchOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Suppress for 5 minutes" Command="{Binding DataContext.Wanted.SuppressWantedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Copy callsign" Command="{Binding DataContext.Wanted.CopyCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy raw message" Command="{Binding DataContext.Wanted.CopyRawMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="70" />
                            <DataGridTextColumn Header="Call" Binding="{Binding ContactableCall}" Width="90" />
                            <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="70" />
                            <DataGridTextColumn Header="Source" Binding="{Binding GridSource}" Width="80" />
                            <DataGridTextColumn Header="Need" Binding="{Binding NeedStatusText}" Width="95" />
                            <DataGridTextColumn Header="Scope" Binding="{Binding WantedScopeText}" Width="115" />
                            <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="55" />
                            <DataGridTextColumn Header="Actionable" Binding="{Binding ActionabilityText}" Width="145" />
                            <DataGridTextColumn Header="Method" Binding="{Binding SelectionMethod}" Width="100" />
                            <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedDetail}" Width="*" />
                            <DataGridTextColumn Header="Age" Binding="{Binding AgeText, Mode=OneWay}" Width="55" />
                            <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Wanted USA States" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border DockPanel.Dock="Bottom" BorderBrush="#D8E0E8" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0" MaxHeight="115">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Wanted Recent Actions" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding WantedRecentActions}" BorderThickness="0" />
                    </DockPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Wanted.WantedStates}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="WantedGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Call this station" Command="{Binding DataContext.Wanted.CallWantedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Watch only" Command="{Binding DataContext.Wanted.WatchOnlyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Suppress for 5 minutes" Command="{Binding DataContext.Wanted.SuppressWantedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="Copy callsign" Command="{Binding DataContext.Wanted.CopyCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Copy raw message" Command="{Binding DataContext.Wanted.CopyRawMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="JTDX Row" Binding="{Binding JtdxRow}" Width="70" />
                        <DataGridTextColumn Header="Call" Binding="{Binding ContactableCall}" Width="90" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="65" />
                        <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="130" />
                        <DataGridTextColumn Header="Need" Binding="{Binding NeedStatusText}" Width="95" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding WantedScopeText}" Width="115" />
                        <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="55" />
                        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="60" />
                        <DataGridTextColumn Header="Actionable" Binding="{Binding ActionabilityText}" Width="145" />
                        <DataGridTextColumn Header="Method" Binding="{Binding SelectionMethod}" Width="100" />
                        <DataGridTextColumn Header="Wanted Reason" Binding="{Binding WantedDetail}" Width="*" />
                        <DataGridTextColumn Header="Age" Binding="{Binding AgeText, Mode=OneWay}" Width="55" />
                        <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="50" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
