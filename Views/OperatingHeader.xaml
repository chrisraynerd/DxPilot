<UserControl x:Class="JtdxAutoResume.V3.Views.OperatingHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:JtdxAutoResume.V3.Views">
 <UserControl.Resources>
  <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="Padding" Value="10,7" /><Setter Property="Margin" Value="0,0,6,4" />
  </Style>
  <Style x:Key="HeaderLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#BBD1E3" /><Setter Property="FontSize" Value="10" />
   <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,4" />
  </Style>
 </UserControl.Resources>
 <Border Background="{StaticResource AppNavy}" Padding="14,10">
  <StackPanel>
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Margin="0,0,18,0" VerticalAlignment="Center">
     <TextBlock Text="DX PILOT" FontSize="23" FontWeight="Bold" Foreground="White" />
     <TextBlock Text="JTDX ASSISTANCE" Foreground="#BBD1E3" FontSize="10" />
    </StackPanel>
    <Button DockPanel.Dock="Right" Content="Stop All" Command="{Binding StopAutoResumeCommand}" Style="{StaticResource DangerButton}" Margin="6,0,0,4" VerticalAlignment="Center" />
    <views:AchievementProfileSelector DockPanel.Dock="Left" VerticalAlignment="Center" />
    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Command="{Binding StartDxAssistCommand}"><Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
       <Setter Property="Content" Value="Start DX Assist" />
       <Style.Triggers><DataTrigger Binding="{Binding IsDxAssistActive}" Value="True">
        <Setter Property="Content" Value="DX Assist active" /><Setter Property="Background" Value="#15803D" />
       </DataTrigger></Style.Triggers>
      </Style>
     </Button.Style></Button>
     <Button Command="{Binding StartWantedSniperCommand}"><Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
       <Setter Property="Content" Value="Start Wanted" />
       <Style.Triggers><DataTrigger Binding="{Binding IsWantedSniperActive}" Value="True">
        <Setter Property="Content" Value="Wanted active" /><Setter Property="Background" Value="#15803D" />
       </DataTrigger></Style.Triggers>
      </Style>
     </Button.Style></Button>
     <Button Command="{Binding StartLocationHuntCommand}"><Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
       <Setter Property="Content" Value="Start Location" />
       <Style.Triggers><DataTrigger Binding="{Binding IsLocationHuntActive}" Value="True">
        <Setter Property="Content" Value="Location active" /><Setter Property="Background" Value="#15803D" />
       </DataTrigger></Style.Triggers>
      </Style>
     </Button.Style></Button>
     <Button Command="{Binding StartScavengerCommand}" IsEnabled="{Binding CanConfigureScavenger}"><Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource ModeButton}">
       <Setter Property="Content" Value="Start Scavenger" />
       <Style.Triggers><DataTrigger Binding="{Binding IsScavengerActive}" Value="True">
        <Setter Property="Content" Value="Scavenger active" /><Setter Property="Background" Value="#15803D" />
       </DataTrigger></Style.Triggers>
      </Style>
     </Button.Style></Button>
    </WrapPanel>
   </DockPanel>
   <Border Background="#23384A" BorderBrush="#385267" BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,8,0,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="2.1*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0">
      <TextBlock Text="OPERATING MODE · BAND" Style="{StaticResource HeaderLabel}" />
      <TextBlock Text="{Binding CurrentTargetStatus.OperatingMode}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
      <TextBlock Foreground="#D5E5F3" Margin="0,3,0,0"><Run Text="{Binding CurrentBand, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CurrentDigitalMode, Mode=OneWay}" /></TextBlock>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,0">
      <TextBlock Text="ACTIVE TARGET · WHY" Style="{StaticResource HeaderLabel}" />
      <TextBlock Text="{Binding CurrentTargetStatus.SelectedTargetDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
      <TextBlock Text="{Binding CurrentTargetStatus.WantedReason}" Foreground="#D5E5F3" TextWrapping="Wrap" Margin="0,3,0,0">
       <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
        <DataTrigger Binding="{Binding CurrentTargetStatus.SelectedTargetCall}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,12,0">
      <TextBlock Text="CALLING / QSO PROGRESS" Style="{StaticResource HeaderLabel}" />
      <TextBlock Text="{Binding CurrentTargetStatus.AttemptCounterLabel}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding CurrentTargetStatus.PlainStatusMessage}" Foreground="#D5E5F3" TextWrapping="Wrap" Margin="0,3,0,0" />
     </StackPanel>
     <StackPanel Grid.Column="3">
      <TextBlock Text="DX PILOT TX PERMISSION" Style="{StaticResource HeaderLabel}" />
      <TextBlock Text="{Binding CurrentTargetStatus.TxGateStatus}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"
                 ToolTip="DX Pilot's permission to control TX—not a live indication that the radio is transmitting. Band Analysis has its own explicit warning banner." />
      <TextBlock Text="{Binding CurrentTargetStatus.ActualJtdxDxCall, StringFormat=JTDX target: {0}}" Foreground="#D5E5F3" TextWrapping="Wrap" Margin="0,3,0,0" />
     </StackPanel>
    </Grid>
   </Border>
  </StackPanel>
 </Border>
</UserControl>
