<UserControl x:Class="JtdxAutoResume.V3.Views.LocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="LOCATION HUNT" Style="{StaticResource SectionEyebrow}" />
                    <TextBlock Text="Choose where in the world DX Pilot should hunt" Style="{StaticResource WorkspaceTitle}" Margin="0,2,0,0" />
                    <TextBlock Text="Selected regions are combined and ranked together; a contactable New DXCC anywhere still has absolute priority." Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Location.Status}" Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <Expander Header="{Binding Location.SelectedAreasDisplay, StringFormat=Hunt-area filters — {0}}"
                          IsExpanded="False" Margin="0,9,0,0">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="All areas" Command="{Binding Location.SelectAllAreasCommand}" MinWidth="70" Padding="8,4" />
                            <Button Content="None" Command="{Binding Location.ClearAllAreasCommand}" MinWidth="55" Padding="8,4" Margin="0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Location.Areas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Title}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ChoiceChipCheckBox}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Expander>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Location.VisiblePanels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Location.PanelColumnCount}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                                    <Setter Property="Height" Value="188" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter Property="Height" Value="560" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="HUNT REGION" Style="{StaticResource SectionEyebrow}" />
                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource AppTextMuted}" FontSize="11" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding FocusButtonText}"
                                            Command="{Binding DataContext.Location.TogglePanelFocusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" MinWidth="64" MinHeight="26" Padding="8,3" Margin="8,0,0,0"
                                            VerticalAlignment="Top" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding Candidates}"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          RowStyle="{StaticResource SemanticStationRowStyle}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          MouseDoubleClick="LocationGrid_MouseDoubleClick"
                                          PreviewMouseRightButtonDown="StationGrid_PreviewMouseRightButtonDown">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="CALL NOW"
                                                      Command="{Binding PlacementTarget.Tag.CallNowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Suppress indefinitely"
                                                      Command="{Binding PlacementTarget.Tag.PermanentlySuppressCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Release suppression"
                                                      Command="{Binding PlacementTarget.Tag.ReleaseSuppressionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Copy callsign"
                                                      Command="{Binding PlacementTarget.Tag.Location.CopyCallsignCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding RankText}" Width="34" />
                                        <DataGridTemplateColumn Header="Call" CellTemplate="{StaticResource WorkedCallsignCallTemplate}" SortMemberPath="Call" Width="70" />
                                        <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="88" />
                                        <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="48" />
                                        <DataGridTemplateColumn Width="44">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.LocationDetailHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.HeaderTemplate>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LocationDetail}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="42" />
                                        <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="38" />
                                        <DataGridTextColumn Header="Row" Binding="{Binding JtdxRow}" Width="38" />
                                        <DataGridTextColumn Header="Wanted reason" Binding="{Binding WantedReason}" Width="160" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding TargetStatus}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
