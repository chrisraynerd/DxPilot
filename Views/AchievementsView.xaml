<UserControl x:Class="JtdxAutoResume.V3.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource AppCanvas}">
    <UserControl.Resources>
        <DataTemplate x:Key="AchievementBandTemplate">
            <Border Margin="1" Padding="2,1" BorderThickness="1" CornerRadius="2" ToolTip="{Binding ToolTip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="#DFE7EF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKey}" Value="LotwConfirmed">
                                <Setter Property="Background" Value="#DCFCE7" />
                                <Setter Property="BorderBrush" Value="#9ACBAA" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKey}" Value="WorkedUnconfirmed">
                                <Setter Property="Background" Value="#FFF7D6" />
                                <Setter Property="BorderBrush" Value="#E8CF80" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding DisplayCount}" Foreground="#173247" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="470" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ACHIEVEMENTS" Style="{StaticResource SectionEyebrow}" />
                    <TextBlock Text="Your achievements, band by band" Style="{StaticResource WorkspaceTitle}" Margin="0,2,0,0" />
                    <TextBlock Text="Explore DXCC countries and USA states across your logbook — with LoTW confirmation shown separately."
                               Foreground="{StaticResource AppTextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LogbookStatus}" Foreground="{StaticResource AppTextMuted}" Margin="0,4,12,0" TextWrapping="Wrap" />
                    <Expander Header="Logbook checks and sources" Margin="0,6,12,0">
                        <StackPanel Margin="0,7,0,0">
                            <TextBlock Text="{Binding Achievements.LogbookHealthSummary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Achievements.CallsignCreditsSummary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding Achievements.StateDataSummary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="Configured full ADIF source" FontWeight="SemiBold" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding Settings.Settings.FullAdifPath}" TextWrapping="Wrap" />
                            <TextBlock Text="Configured live JTDX log" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding Settings.Settings.LiveJtdxAdifPath}" TextWrapping="Wrap" />
                            <TextBlock Text="Use Refresh after the loaded logbook changes. Display refresh time is not the date of a LoTW download." Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="GLOBAL ACHIEVEMENT PROFILE" Style="{StaticResource SectionEyebrow}" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Import ADIF…" Command="{Binding LoadAdifCommand}"
                                Margin="8,0,0,0" Padding="14,6" ToolTip="Choose your updated full ADIF export, using the same import as Settings." />
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshAchievementsCommand}"
                                Margin="8,0,0,0" Padding="14,6" />
                        <TextBlock Text="{Binding SelectedAchievementProfileDisplayLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Achievements.ProfileSummary}" Foreground="{StaticResource AppTextMuted}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,6,0" Background="#E8F7EE">
                <StackPanel>
                    <TextBlock Text="LoTW CONFIRMED" Style="{StaticResource SectionEyebrow}" />
                    <TextBlock Text="{Binding Achievements.LotwConfirmedEntities}" FontSize="27" FontWeight="SemiBold" Foreground="#166534" />
                    <TextBlock Foreground="#39714C"><Run Text="{Binding Achievements.ProgressDisplay, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Achievements.ListDescription, Mode=OneWay}" /></TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="2,0,4,0" Background="#FFF7D6">
                <StackPanel>
                    <TextBlock Text="WORKED — AWAITING LoTW" Style="{StaticResource SectionEyebrow}" />
                    <TextBlock Text="{Binding Achievements.WorkedUnconfirmedEntities}" FontSize="27" FontWeight="SemiBold" Foreground="#92400E" />
                    <TextBlock Text="Countries / states awaiting confirmation" Foreground="#8A5A22" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="4,0,2,0" Background="#F7F9FB">
                <StackPanel>
                    <TextBlock Text="STILL NEEDED" Style="{StaticResource SectionEyebrow}" />
                    <TextBlock Text="{Binding Achievements.NeededEntities}" FontSize="27" FontWeight="SemiBold" Foreground="#334155" />
                    <TextBlock Text="Countries / states with no matching QSO" Foreground="{StaticResource AppTextMuted}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="6,0,0,0" Background="#EEF5FB">
                <StackPanel>
                    <TextBlock Text="PROFILE QSOs" Style="{StaticResource SectionEyebrow}" />
                    <TextBlock Text="{Binding Achievements.ProfileQsoCount, StringFormat={}{0:N0}}" FontSize="27" FontWeight="SemiBold" Foreground="#1D4F73" />
                    <TextBlock Text="{Binding Achievements.LastRefreshedDisplay}" Foreground="{StaticResource AppTextMuted}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,10" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Search" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Achievements.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,12,0" ToolTip="Search by country, DXCC number, difficulty, state name or state code." />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Show" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Achievements.StatusFilters}"
                              SelectedItem="{Binding Achievements.SelectedStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,3,12,0" Padding="6,4" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Achievements.VisibleSummary}" FontWeight="SemiBold" />
                    <TextBlock Text="Green = LoTW count · Amber = worked count, none LoTW confirmed · White = not worked. Hover a band for both counts; double-click a row for all QSOs."
                               Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" Margin="0,3,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Achievements.SelectedAreaIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Club Log rank: 1 = most difficult" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="Bundled Club Log / UK desirability list" Foreground="{StaticResource AppTextMuted}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="3" SelectedIndex="{Binding Achievements.SelectedAreaIndex, Mode=TwoWay}"
                    ItemContainerStyle="{StaticResource WorkspaceSubTabItemStyle}" Background="White" BorderThickness="0">
            <TabItem Header="DXCC countries">
        <Border Style="{StaticResource PanelBorder}" Padding="0">
            <DataGrid x:Name="AchievementsGrid"
                      ItemsSource="{Binding Achievements.DxccRows}"
                      MouseDoubleClick="AchievementsGrid_MouseDoubleClick"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      RowHeight="30" ColumnHeaderHeight="34"
                      FrozenColumnCount="3"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="{StaticResource AppText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKey}" Value="LotwConfirmed">
                                <Setter Property="Background" Value="#DCFCE7" />
                                <Setter Property="Foreground" Value="#14532D" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKey}" Value="WorkedUnconfirmed">
                                <Setter Property="Background" Value="#FFF7D6" />
                                <Setter Property="Foreground" Value="#78350F" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SeenButNeeded}" Value="True">
                                <Setter Property="Background" Value="#EAF4FF" />
                                <Setter Property="Foreground" Value="#1E4F78" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CL rank" Binding="{Binding ClubLogRankDisplay}" SortMemberPath="ClubLogRank" Width="75" />
                    <DataGridTextColumn Header="DXCC" Binding="{Binding DxccNumber}" Width="58" />
                    <DataGridTextColumn Header="Country / entity" Binding="{Binding EntityName}" Width="170" />
                    <DataGridTemplateColumn Header="QSOs" SortMemberPath="QsoCount" Width="52">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="QsoCount_Click" Background="Transparent" BorderThickness="0" Padding="3,0"
                                        MinWidth="0" MinHeight="0" Margin="0"
                                        Foreground="#1D4F73" Cursor="Hand" ToolTip="Open all QSOs for this DXCC">
                                    <TextBlock Text="{Binding QsoCount}" TextDecorations="Underline" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Awaiting" SortMemberPath="UnconfirmedQsoCount" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="QsoCount_Click" Background="Transparent" BorderThickness="0" Padding="3,0"
                                        MinWidth="0" MinHeight="0" Margin="0"
                                        Foreground="#1D4F73" Cursor="Hand" ToolTip="Open all QSOs for this DXCC">
                                    <TextBlock Text="{Binding UnconfirmedQsoCount}" TextDecorations="Underline" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="LoTW" SortMemberPath="LotwConfirmedQsoCount" Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="QsoCount_Click" Background="Transparent" BorderThickness="0" Padding="3,0"
                                        MinWidth="0" MinHeight="0" Margin="0"
                                        Foreground="#1D4F73" Cursor="Hand" ToolTip="Open all QSOs for this DXCC">
                                    <TextBlock Text="{Binding LotwConfirmedQsoCount}" TextDecorations="Underline" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last worked" Binding="{Binding LastWorkedDisplay}" SortMemberPath="LastWorked" Width="92" />
                    <DataGridTextColumn Header="Decodes seen" Binding="{Binding SeenCount}" Width="96" />
                    <DataGridTextColumn Header="Unique calls" Binding="{Binding SeenCallCount}" Width="90" />
                    <DataGridTextColumn Header="Difficulty" Binding="{Binding DifficultyBand}" Width="95" />
                    <DataGridTextColumn Header="UK score" Binding="{Binding UKDesirabilityDisplay}" SortMemberPath="UKDesirability" Width="65" />
                    <DataGridTextColumn Header="Bands" Binding="{Binding Bands}" Width="125" />
                    <DataGridTextColumn Header="Modes" Binding="{Binding Modes}" Width="90" />
                    <DataGridTextColumn Header="Achievement status" Binding="{Binding StatusDisplay}" Width="*" MinWidth="145" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
            </TabItem>
            <TabItem Header="USA states">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Achievements.StateDataSummary}" Margin="10,8" Foreground="{StaticResource AppTextMuted}" TextWrapping="Wrap" />
                    <DataGrid x:Name="StatesGrid" Grid.Row="1" ItemsSource="{Binding Achievements.StateRows}"
                              RowStyle="{Binding RowStyle, ElementName=AchievementsGrid}"
                              MouseDoubleClick="AchievementsGrid_MouseDoubleClick"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              FrozenColumnCount="2" RowHeight="30" ColumnHeaderHeight="34" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding StateCode}" Width="58" />
                            <DataGridTextColumn Header="State" Binding="{Binding EntityName}" Width="175" />
                            <DataGridTextColumn Header="QSOs" Binding="{Binding QsoCount}" Width="65" />
                            <DataGridTextColumn Header="Awaiting" Binding="{Binding UnconfirmedQsoCount}" Width="75" />
                            <DataGridTextColumn Header="LoTW QSOs" Binding="{Binding LotwConfirmedQsoCount}" Width="85" />
                            <DataGridTextColumn Header="Last worked" Binding="{Binding LastWorkedDisplay}" SortMemberPath="LastWorked" Width="100" />
                            <DataGridTextColumn Header="Modes" Binding="{Binding Modes}" Width="90" />
                            <DataGridTextColumn Header="Achievement status" Binding="{Binding StatusDisplay}" Width="*" MinWidth="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
