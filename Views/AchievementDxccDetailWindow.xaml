<Window x:Class="JtdxAutoResume.V3.Views.AchievementDxccDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXCC QSO history"
        Width="1180" Height="680" MinWidth="880" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#EEF3F7">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Padding="14,11" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DXCC QSO HISTORY" Style="{StaticResource SectionEyebrow}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource WorkspaceTitle}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource AppTextMuted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="18,0,0,0">
                    <TextBlock Text="LoTW CONFIRMED" Style="{StaticResource SectionEyebrow}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Entity.LotwConfirmedQsoCount}" FontSize="27" FontWeight="SemiBold"
                               Foreground="#166534" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Qsos}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FFF7D6" />
                        <Setter Property="Foreground" Value="#78350F" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LotwConfirmed}" Value="True">
                                <Setter Property="Background" Value="#DCFCE7" />
                                <Setter Property="Foreground" Value="#14532D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Callsign" Binding="{Binding Call}" Width="92" />
                    <DataGridTextColumn Header="Your callsign" Binding="{Binding StationCallsign}" Width="95" />
                    <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" SortMemberPath="QsoDate" Width="100" />
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="95" />
                    <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="58" />
                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="65" />
                    <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="78" />
                    <DataGridTextColumn Header="Grid" Binding="{Binding Grid}" Width="72" />
                    <DataGridTextColumn Header="LoTW" Binding="{Binding LotwDisplay}" Width="82" />
                    <DataGridTextColumn Header="Paper QSL" Binding="{Binding PaperDisplay}" Width="80" />
                    <DataGridTextColumn Header="eQSL" Binding="{Binding EqslDisplay}" Width="72" />
                    <DataGridTextColumn Header="ADIF source" Binding="{Binding Source}" Width="*" MinWidth="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Green rows are LoTW confirmed; amber rows are awaiting LoTW confirmation."
                       Foreground="{StaticResource AppTextMuted}" VerticalAlignment="Center" />
            <Button Content="Close" IsCancel="True" Padding="22,7" HorizontalAlignment="Right" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
