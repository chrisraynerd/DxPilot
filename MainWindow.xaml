<Window x:Class="JtdxAutoResume.V3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JtdxAutoResume.V3.Views"
        Title="AutoResume V3 by 2E0CCD"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="660"
        Background="#F3F6F8"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#172331" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AutoResume V3" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding Dashboard.OverallStatus}" Foreground="#C9D7E6" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start UDP" Command="{Binding StartUdpCommand}" />
                    <Button Content="Stop UDP" Command="{Binding StopUdpCommand}" />
                    <Button Content="Start DX Assist" Command="{Binding StartDxAssistCommand}" />
                    <Button Content="Start Wanted Sniper" Command="{Binding StartWantedSniperCommand}" />
                    <Button Content="Stop All" Command="{Binding StopAutoResumeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="14">
            <TabItem Header="Dashboard">
                <views:DashboardView />
            </TabItem>
            <TabItem Header="DX Assist">
                <views:DxAssistView />
            </TabItem>
            <TabItem Header="Wanted">
                <views:WantedView />
            </TabItem>
            <TabItem Header="Session History">
                <views:SessionHistoryView />
            </TabItem>
            <TabItem Header="Scheduler">
                <views:SchedulerView />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
