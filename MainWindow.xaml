<Window x:Class="JtdxAutoResume.V3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JtdxAutoResume.V3.Views"
        Title="DX Pilot for JTDX by G1CEC"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="660"
        Background="{StaticResource AppCanvas}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AppNavy}" Padding="18,12,18,11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DX PILOT" FontSize="23" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="INTELLIGENT JTDX ASSISTANCE" Foreground="#8FA9BE" FontSize="10" FontWeight="SemiBold" Margin="1,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start DX Assist" Command="{Binding StartDxAssistCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDxAssistActive}" Value="True">
                                        <Setter Property="Background" Value="#16A34A" />
                                        <Setter Property="BorderBrush" Value="#15803D" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Content" Value="DX Assist Active" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Start Wanted Sniper" Command="{Binding StartWantedSniperCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWantedSniperActive}" Value="True">
                                        <Setter Property="Background" Value="#16A34A" />
                                        <Setter Property="BorderBrush" Value="#15803D" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Content" Value="Wanted Active" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Start Location Hunt" Command="{Binding StartLocationHuntCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocationHuntActive}" Value="True">
                                        <Setter Property="Background" Value="#16A34A" />
                                        <Setter Property="BorderBrush" Value="#15803D" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Content" Value="Location Active" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Stop All" Command="{Binding StopAutoResumeCommand}" Style="{StaticResource DangerButton}" Margin="4,0,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentBand}" Foreground="White" FontWeight="Bold" />
                            <TextBlock Text=" · " Foreground="#8FA9BE" />
                            <TextBlock Text="{Binding CurrentDigitalMode}" Foreground="White" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentTargetStatus.OperatingMode}" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="  ·  " Foreground="#8FA9BE" />
                            <TextBlock Text="{Binding CurrentTargetStatus.QsoState}" Foreground="#C7D7E5" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatusPill}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TARGET" Foreground="#8FA9BE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentTargetStatus.SelectedTargetDisplay}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StatusPill}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TX" Foreground="#8FA9BE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CurrentTargetStatus.TxGateStatus}" Foreground="White" FontWeight="SemiBold" MaxWidth="290" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="#FEF3C7" />
                    <Setter Property="BorderBrush" Value="#D97706" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BandAnalysis.AnalysisBannerVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BandAnalysis.AnalysisBannerTone}" Value="Listening">
                            <Setter Property="Background" Value="#DBEAFE" />
                            <Setter Property="BorderBrush" Value="#2563EB" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BandAnalysis.AnalysisBannerTone}" Value="Transmitting">
                            <Setter Property="Background" Value="#FEE2E2" />
                            <Setter Property="BorderBrush" Value="#DC2626" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#172331" CornerRadius="18" Padding="11,5" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="BAND ANALYSIS" Foreground="White" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding BandAnalysis.AnalysisBannerTitle}" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="{Binding BandAnalysis.AnalysisBannerPhase}" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding BandAnalysis.AnalysisBannerMessage}" TextWrapping="Wrap" Margin="0,2,12,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="Stop analysis" Command="{Binding StopBandSurveyCommand}"
                        VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#991B1B" Foreground="#7F1D1D" />
            </Grid>
        </Border>

        <Expander DockPanel.Dock="Top"
                  Header="Station colour legend"
                  IsExpanded="False"
                  Background="White"
                  BorderBrush="{StaticResource AppBorder}"
                  BorderThickness="0,0,0,1"
                  Padding="14,6"
                  FontWeight="SemiBold">
            <WrapPanel VerticalAlignment="Center" Margin="0,7,0,2">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticNewDxccBackground}" />
                    <TextBlock Text="New DXCC" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticUnconfirmedDxccBackground}" />
                    <TextBlock Text="Unconfirmed DXCC" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticNewGridBackground}" />
                    <TextBlock Text="New grid" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticNewStateBackground}" />
                    <TextBlock Text="New state" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticRareDxccBackground}" />
                    <TextBlock Text="Rare country (confirmed)" VerticalAlignment="Center"
                               ToolTip="Optional repeat contact with a DXCC already confirmed, selected because it ranks highly in the rarity list." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticBandModeBackground}" />
                    <TextBlock Text="Band/mode" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticNotContactableBackground}" />
                    <TextBlock Text="Off-grid" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}" Background="{StaticResource SemanticPermanentSuppressedBackground}" />
                    <TextBlock Text="Suppressed" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SemanticLegendSwatch}"
                            Background="White"
                            BorderBrush="{StaticResource SemanticCallingBorder}"
                            BorderThickness="3" />
                    <TextBlock Text="Calling / selected" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}"
                            Background="White"
                            BorderBrush="{StaticResource SemanticInProgressBorder}"
                            BorderThickness="3" />
                    <TextBlock Text="In QSO / worked" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <Border Style="{StaticResource SemanticLegendSwatch}"
                            Background="{StaticResource SemanticFailedBackground}"
                            BorderBrush="{StaticResource SemanticFailedBorder}"
                            BorderThickness="3" />
                    <TextBlock Text="Failed / mismatch" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                            ToolTip="This exact callsign was worked using the currently selected achievement callsign.">
                    <TextBlock Text="Worked on selected callsign" TextDecorations="Strikethrough" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                            ToolTip="This exact callsign was worked, but only under another one of your station callsigns.">
                    <TextBlock Text="Worked under another callsign" Foreground="#718096" TextDecorations="Strikethrough" VerticalAlignment="Center" />
                    <TextBlock Text="↺" Foreground="#718096" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
        </Expander>

        <TabControl Style="{StaticResource AppNavigationTabControlStyle}"
                    ItemContainerStyle="{StaticResource AppNavigationTabItemStyle}">
            <TabItem Header="Live Monitor">
                <views:DashboardView />
            </TabItem>
            <TabItem Header="DX Assist">
                <DockPanel>
                    <views:CompactConditionsStrip DockPanel.Dock="Top" />
                    <views:DxAssistView />
                </DockPanel>
            </TabItem>
            <TabItem Header="Wanted">
                <DockPanel>
                    <views:CompactConditionsStrip DockPanel.Dock="Top" />
                    <views:WantedView />
                </DockPanel>
            </TabItem>
            <TabItem Header="Location">
                <DockPanel>
                    <views:CompactConditionsStrip DockPanel.Dock="Top" />
                    <views:LocationView />
                </DockPanel>
            </TabItem>
            <TabItem Header="Map">
                <DockPanel>
                    <views:CompactConditionsStrip DockPanel.Dock="Top" />
                    <views:MapView />
                </DockPanel>
            </TabItem>
            <TabItem Header="Session History">
                <DockPanel>
                    <views:CompactConditionsStrip DockPanel.Dock="Top" />
                    <views:SessionHistoryView />
                </DockPanel>
            </TabItem>
            <TabItem Header="Band Analysis">
                <DockPanel>
                    <views:CompactConditionsStrip DockPanel.Dock="Top" />
                    <views:SchedulerView />
                </DockPanel>
            </TabItem>
            <TabItem Header="Settings">
                <DockPanel>
                    <views:CompactConditionsStrip DockPanel.Dock="Top" />
                    <views:SettingsView />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
