<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>AutoResume.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DXPilot-for-JTDX-G1CEC</AssemblyName>
    <RootNamespace>JtdxAutoResume.V3</RootNamespace>
    <Product>DX Pilot for JTDX</Product>
    <Title>DX Pilot for JTDX</Title>
    <Description>Intelligent DX hunting and station control for JTDX</Description>
    <Authors>G1CEC</Authors>
    <Company>G1CEC</Company>
    <Copyright>Copyright © G1CEC 2026</Copyright>
    <Version>3.4.1</Version>
    <AssemblyVersion>3.4.1.0</AssemblyVersion>
    <FileVersion>3.4.1.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="AutoResume.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\cty.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\DXCC-UK-Desirability-G1CEC.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mapsui.Wpf" Version="5.1.0" />
  </ItemGroup>

</Project>
